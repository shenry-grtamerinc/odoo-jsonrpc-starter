# ============================================================
# ODOO JSON-RPC CONNECTION
# ============================================================

# The main address of the Odoo server.
# Do not add /web/login or a slash at the end.
ODOO_BASE=https://your-odoo-server.example.com

# The exact Odoo database name.
# To find it, log into Odoo and open Chrome Inspect > Console.
# Then enter: odoo.session_info.db
ODOO_DB=your_database_name

# The email address used to sign in to Odoo.
OD_EMAIL=your_odoo_email@example.com

# Your Odoo password 
OD_PASS=your_odoo_password


# ============================================================
# PRODUCT TO READ OR UPDATE
# ============================================================

# The SKU/internal reference of the one product you want to use.
# Change this value when you want to work with another product.
PRODUCT_SKU=ONE-SKU-HERE


# ============================================================
# ODOO CONNECTION OPTIONS
# ============================================================

# Verifies the Odoo server's HTTPS security certificate.
# This should normally remain true.
VERIFY_SSL=true

# Maximum number of seconds to wait for an Odoo response.
ODOO_TIMEOUT=30


# ============================================================
# AI SETTINGS FOR odoo_read_and_write.py
# ============================================================

# The AI provider used to generate the proposed product update.
LLM_PROVIDER=anthropic

# The Anthropic model used by the script.
LLM_MODEL=claude-sonnet-4-5

# Maximum number of seconds to wait for the AI response.
LLM_TIMEOUT=120

# Your Anthropic API key.
# Never put your real key in this example file.
ANTHROPIC_API_KEY=your_anthropic_api_key

# Anthropic's API address.
# This normally does not need to be changed.
ANTHROPIC_API_BASE=https://api.anthropic.com/v1
